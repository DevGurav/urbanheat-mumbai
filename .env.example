# Copy to .env and fill in. Never commit .env.

# --- Google Earth Engine (Phase 0+) ---
# Cloud project ID registered for noncommercial Earth Engine access.
GEE_PROJECT_ID=your-ee-project-id

# --- LLM provider (Phase 4+) ---
# Google AI Studio key: https://aistudio.google.com/apikey  (free tier, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional fallback provider used when Gemini rate limits are hit.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# Where the pipeline writes and the API reads its feature table.
DATA_DIR=./data
MODEL_DIR=./models
CHROMA_DIR=./backend/rag/chroma_db

# --- Supabase (Phase 6+) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Notifications (optional, Phase 4+) ---
# Gmail address + app password (not the account password) for alert emails.
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_RECIPIENTS=

# --- Frontend (Phase 5+; must be prefixed VITE_ to reach the browser) ---
VITE_API_BASE_URL=http://localhost:8000
