data/raw/*
data/interim/*
data/processed/*
data/knowledge_base/*
!data/**/.gitkeep
# small vector artifacts are allowed back in
!data/processed/*.geojson
*.tif
*.tiff
*.parquet
*.gpkg
*.zip

# model artifacts
models/*
!models/.gitkeep

# vector store
**/chroma_db/
**/.chroma/

# OSMnx Overpass HTTP response cache (regenerated on download)
cache/

# logs / os / editor
*.log
